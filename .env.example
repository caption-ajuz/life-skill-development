PORT=3000
NODE_ENV=production
JWT_SECRET=your-random-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# MongoDB Atlas
MONGODB_URI=mongodb://<db_username>:<password>@cluster-shard-00-00.mongodb.net:27017,.../life-skill-course?ssl=true&replicaSet=...&authSource=admin

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
